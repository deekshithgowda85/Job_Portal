# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values
# Schedule is hardcoded: 06:00 AM IST and 06:00 PM IST automatically.
# No cron configuration needed.
# ─────────────────────────────────────────────────────────────────────────────

# Redis (use redis://redis:6379/0 inside Docker, redis://localhost:6379/0 outside)
REDIS_URL=redis://redis:6379/0

# Your Next.js job portal URL
PORTAL_API_URL=https://your-job-portal.vercel.app

# Secret key — set the same value in your Next.js .env as CRAWLER_API_KEY
PORTAL_API_KEY=your-secret-portal-api-key

# API key to protect the /crawl/* manual trigger endpoints on this service
SERVICE_API_KEY=your-service-api-key

# Run browsers headless (always true in production)
PLAYWRIGHT_HEADLESS=true

# Max jobs fetched per company per crawl run
MAX_JOBS_PER_COMPANY=100

# How many days before a seen job can re-appear (dedup TTL)
DEDUP_TTL_DAYS=30

# Optional rotating proxies, comma-separated. Leave empty to disable.
PROXY_LIST=
